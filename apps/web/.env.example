# Local development template only. Copy to .env.local and fill in your own values.
# Netlify does not automatically load this file; configure production values in
# Netlify Project configuration > Environment variables instead.

# Runtime database connection. Use the pooled Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Used only when you run Drizzle migrations from your trusted local machine.
# Prefer the direct (non-`-pooler`) Neon URL. Do not add this to Netlify unless
# you intentionally run migrations there (the deployment guide advises against it).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full

# Better Auth. Use a unique random value with at least 32 bytes.
BETTER_AUTH_SECRET=generate-a-random-secret-with-at-least-32-bytes
BETTER_AUTH_URL=http://localhost:3100
# Optional canonical public URL for SEO artifacts (sitemap.xml, robots.txt).
# Falls back to BETTER_AUTH_URL when unset; never put secrets here.
# SITE_URL=https://your-production-domain.example

# Independent random 32-byte base64url key for encrypting user-supplied provider keys.
# Losing this key makes already-saved provider credentials unreadable.
PROVIDER_SECRET_ENCRYPTION_KEY=generate-a-random-32-byte-base64url-key
PROVIDER_SECRET_ENCRYPTION_KEY_ID=v1
# Keep prior key IDs here during a re-encryption window; never commit real values.
# PROVIDER_SECRET_ENCRYPTION_KEYRING={"previous-id":"previous-base64url-key"}
# Optional LOCAL E2E-only key used by the production-path test script.
# Normal Gemini BYOK connections are provided by each user in the app; this is
# not required for Netlify runtime and should not be configured there.
GEMINI_API_KEY=

# E2E-only settings. Do not set these as production application settings.
E2E_REQUIRE_GEMINI=false
E2E_BASE_URL=http://localhost:3100
E2E_TIMEOUT_MS=10000
# Remote staging runs also require E2E_TARGET=staging, E2E_ALLOW_REMOTE=true,
# and E2E_DATABASE_URL for that same staging environment.
# Production writes additionally require E2E_TARGET=production and
# E2E_CONFIRM_PRODUCTION_WRITE=yes.
